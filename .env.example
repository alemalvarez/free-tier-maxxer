# free-tier-maxxer — copy to .env (git-ignored; run `chmod 600 .env`).
# Every token is READ-ONLY; the scopes below are the minimum verified in feasibility/*.md.
# Leave a provider's lines empty if you don't use it: its check is skipped.
# Nothing here is ever logged, saved to checks/out or committed. Rotate any token you paste somewhere by mistake.

# Name shown in the dashboard title (defaults to your Supabase project name).
FTM_PROJECT_NAME=

# ── GitHub ─────────────────────────────────────────────────────────────────
# Fine-grained PAT: github.com/settings/personal-access-tokens → "Account permissions" → Plan: Read-only. No repo access.
GITHUB_TOKEN=github_pat_...
GITHUB_USERNAME=your-login

# ── PostHog Cloud ──────────────────────────────────────────────────────────
# Personal API key (phx_...): Settings → Personal API keys. Scopes: billing:read, query:read. Must be an ORG OWNER key.
# Org-scoped key preferred (billing is org-level). Host is the private API host (no ".i."): https://us.posthog.com or https://eu.posthog.com
POSTHOG_API_KEY=phx_...
POSTHOG_HOST=https://eu.posthog.com
POSTHOG_PROJECT_ID=12345

# ── Langfuse Cloud ─────────────────────────────────────────────────────────
# Project keys from Project Settings → API Keys. No read-only variant exists; keep the key to one project.
# Host: https://cloud.langfuse.com (EU) | https://us.cloud.langfuse.com (US) | https://jp.cloud.langfuse.com (JP)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
# Day-of-month your org was created (billing anchor; not exposed by API). Leave empty if unknown.
LANGFUSE_BILLING_ANCHOR_DAY=

# ── Supabase ───────────────────────────────────────────────────────────────
# Scoped PAT: supabase.com/dashboard/account/tokens → permissions: projects_read, database_read (organization_admin_read only if you want plan detection)
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_ORG_SLUG=your-org-slug
SUPABASE_PROJECT_REF=abcdefghijklmnopqrst
# Day-of-month your org was created (billing anchor; not exposed by API). Leave empty if unknown.
SUPABASE_BILLING_ANCHOR_DAY=

# ── Vercel ─────────────────────────────────────────────────────────────────
# Token: vercel.com/account/tokens → scope: your Hobby team (team-scoped, NOT project-scoped). Full-account tokens work if you set VERCEL_TEAM_ID.
VERCEL_TOKEN=vcp_...
# Only needed if the token is full-account scoped. Find via GET /v2/teams or GET /v2/user (defaultTeamId).
VERCEL_TEAM_ID=
